<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1920dp"
    android:height="1080dp"
    android:viewportWidth="1920"
    android:viewportHeight="1080">

    <!-- Base neon background -->
    <path
        android:pathData="M0,0 L1920,0 L1920,1080 L0,1080 Z"
        android:fillColor="#001F33" />

    <!-- Cyan glow overlay -->
    <path
        android:pathData="M0,0 L1920,0 L1920,1080 L0,1080 Z"
        android:fillColor="#00FFFF"
        android:fillAlpha="0.18" />

    <!-- Diagonal neon streak -->
    <path
        android:pathData="M0,900 L1920,200 L1920,350 L0,1050 Z"
        android:fillColor="#00FFFF"
        android:fillAlpha="0.32" />

    <!-- Soft top glow -->
    <path
        android:pathData="M0,0 L1920,0 L1920,200 L0,200 Z"
        android:fillColor="#00FFFF"
        android:fillAlpha="0.12" />

</vector>
