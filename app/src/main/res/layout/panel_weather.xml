<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- CURRENT WEATHER -->
    <TextView
        android:id="@+id/weatherCondition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Partly Cloudy"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/weatherTemperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14°"
        android:textColor="#4DA3FF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/weatherFeelsLike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feels like 12°"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/weatherLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="London"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:paddingTop="8dp" />

    <!-- 5-DAY FORECAST -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp">

        <!-- DAY 1 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/day1Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/day1Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed 19° / 10°"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- DAY 2 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/day2Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_weather_partlycloud" />

            <TextView
                android:id="@+id/day2Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thu 17° / 9°"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- DAY 3 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/day3Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_weather_rain" />

            <TextView
                android:id="@+id/day3Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fri 16° / 8°"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- DAY 4 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/day4Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_weather_cloud" />

            <TextView
                android:id="@+id/day4Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sat 15° / 7°"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- DAY 5 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/day5Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_weather_suncloud" />

            <TextView
                android:id="@+id/day5Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sun 18° / 11°"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
