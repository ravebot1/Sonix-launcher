<resources>

    <!-- BASE APP THEME -->
    <style name="Theme.Sonix.Default" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/sonix_background</item>
        <item name="android:textColor">@color/sonix_text_primary</item>
        <item name="android:colorAccent">@color/sonix_accent</item>
    </style>

    <!-- DARK THEME -->
    <style name="Theme.Sonix.Dark" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textColor">@color/sonix_text_primary</item>
        <item name="android:colorAccent">@color/sonix_accent</item>
    </style>

    <!-- NEON THEME -->
    <style name="Theme.Sonix.Neon" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/sonix_neon_background</item>
        <item name="android:textColor">@color/sonix_text_primary</item>
        <item name="android:colorAccent">@color/sonix_accent</item>
    </style>

</resources>
